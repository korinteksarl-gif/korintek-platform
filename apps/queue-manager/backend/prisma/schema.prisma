// KORINTEK QUEUE MANAGER — Schéma de base de données
// Ce schéma constitue la base de "KORINTEK ID", l'identité commune
// destinée à être réutilisée par les futurs modules (Billing, CRM, Training).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PENDING
  SUPER_ADMIN
  ADMIN
  RECEPTION
  EXAM_CENTER_AGENT
  FINANCE
  TRAINER
}

enum CandidateStatus {
  WAITING     // en salle d'attente
  ADMISSION   // à J-15min de son examen — doit monter pour les formalités d'admission
  CALLED      // appelé en salle d'examen (poste occupé)
  IN_PROGRESS // réservé pour usage futur (non utilisé activement en V1)
  COMPLETED
  ABSENT
}

model User {
  id           String     @id @default(uuid())
  nom          String
  prenom       String
  email        String     @unique
  passwordHash String?
  azureId      String?    @unique // "oid" claim Entra ID — présent pour les comptes SSO Office 365
  role         Role       @default(PENDING)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  auditLogs    AuditLog[]

  @@map("users")
}

model Candidate {
  id                  String           @id @default(uuid())
  numero              String           // A001, A002... unique PAR JOUR (voir @@unique ci-dessous)
  nom                 String
  prenom              String
  email               String?
  telephone           String?
  examen              String
  poste               String?          // ex: "Poste 1" — permet de suivre les retards par poste
  dureeMinutes         Int              @default(120) // durée estimée de l'examen, utilisée pour détecter les retards
  datePassage         DateTime         @db.Date
  heureConvocation    String           // heure de début d'examen prévue (HH:MM)
  statut              CandidateStatus  @default(WAITING)
  admissionNotifiedAt DateTime?        // horodatage du passage automatique en statut ADMISSION (T-15min)
  startedAt           DateTime?        // horodatage réel de début d'examen (passage à CALLED)
  completedAt         DateTime?        // horodatage réel de fin d'examen
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([numero, datePassage])
  @@index([datePassage])
  @@map("candidates")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("audit_logs")
}

model Advertisement {
  id        String   @id @default(uuid())
  title     String?
  imageData String   @db.Text // image encodée en base64 (data URL) — pas de stockage fichier externe requis
  linkUrl   String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("advertisements")
}
