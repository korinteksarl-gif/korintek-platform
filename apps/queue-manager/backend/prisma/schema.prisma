// KORINTEK QUEUE MANAGER — Schéma de base de données
// Ce schéma constitue la base de "KORINTEK ID", l'identité commune
// destinée à être réutilisée par les futurs modules (Billing, CRM, Training).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  RECEPTION
  EXAM_CENTER_AGENT
  FINANCE
  TRAINER
}

enum CandidateStatus {
  WAITING
  CALLED
  IN_PROGRESS
  COMPLETED
  ABSENT
}

model User {
  id           String     @id @default(uuid())
  nom          String
  prenom       String
  email        String     @unique
  passwordHash String
  role         Role
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  auditLogs    AuditLog[]

  @@map("users")
}

model Candidate {
  id               String           @id @default(uuid())
  numero           String           @unique // A001, A002...
  nom              String
  prenom           String
  email            String?
  telephone        String?
  examen           String
  datePassage      DateTime         @db.Date
  heureConvocation String
  statut           CandidateStatus  @default(WAITING)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([datePassage])
  @@map("candidates")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("audit_logs")
}
